includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        # These traits are used only by single-file Livewire components in resources/views,
        # which PHPStan does not analyse.
        -
            identifier: trait.unused
            paths:
                - app/Livewire/Concerns/*
                - app/Concerns/ProfileValidationRules.php
